extends TestCase
## The in-game manual (data/manual/es/*.md, game/manual/manual_content.gd): every chapter has
## pages, every page has text and a picture, and every picture exists (screenshots of the game
## generated by the walkthrough scenario "manual").


func test_every_page_has_text_and_an_existing_picture() -> void:
	var chapters := ManualContent.load_chapters()
	assert_true(chapters.size() >= 8, "chapters loaded (%d)" % chapters.size())
	for c: Dictionary in chapters:
		assert_true(String(c["title"]) != "", "%s has a title" % c["file"])
		var pages: Array = c["pages"]
		assert_true(pages.size() >= 1, "%s has pages" % c["file"])
		for p: Dictionary in pages:
			var where := "%s / %s" % [c["file"], p["title"]]
			assert_true(String(p["text"]).length() > 80, "%s: has real text" % where)
			assert_true(String(p["image"]).begins_with("res://assets/manual/"), "%s: has a picture" % where)
			assert_true(ResourceLoader.exists(p["image"]), "%s: picture %s exists" % [where, p["image"]])
			assert_true(String(p["alt"]) != "", "%s: picture has a description" % where)


func test_markdown_subset() -> void:
	var c := ManualContent.parse("# Título\n## Página uno\n![Una captura](res://x.png)\nTexto **fuerte** con `ip`.\n\n- punto\n1. paso\n> consejo [x]\n## Página dos\nOtro texto.")
	assert_eq(c["title"], "Título", "chapter title")
	var pages: Array = c["pages"]
	assert_eq(pages.size(), 2, "two pages")
	assert_eq(pages[0]["image"], "res://x.png", "picture path")
	assert_eq(pages[0]["alt"], "Una captura", "picture description")
	var text: String = pages[0]["text"]
	assert_contains(text, "[b]fuerte[/b]", "bold")
	assert_contains(text, "[code]ip[/code]", "code")
	assert_contains(text, "•  punto", "bullet")
	assert_contains(text, "[b]1.[/b][/color] paso", "numbered step")
	assert_contains(text, "[lb]x]", "square brackets escaped")
	assert_eq(pages[1]["image"], "", "second page without picture")
