[gd_resource type="Resource" script_class="ShopListing" format=3]

[ext_resource type="Script" path="res://sim/hardware/shop_listing.gd" id="1_e4cj4"]

[resource]
script = ExtResource("1_e4cj4")
item_id = &"rack_12u_open"
title = "Rackwell RW-12 — Rack abierto de suelo de 19\" con 12U y cuatro postes, para homelab y pequeña oficina"
bullets = PackedStringArray("12 unidades (12U) de 19\": sitio para el switch, los servidores y lo que vaya llegando.", "Estructura abierta de cuatro postes: llegas al frontal y a la trasera sin quitar paneles.", "Unidades numeradas en los postes para montar cada equipo a la altura exacta.", "Pide 50 cm libres delante y detrás para trabajar con comodidad en el frontal y en la trasera.", "Se puede cambiar de sitio con los equipos montados.")
description = "El RW-12 es el punto de partida de muchos homelabs: un rack de suelo abierto, sin puertas ni paneles laterales, con la medida estándar de 19 pulgadas.

Cada unidad (U) mide 44,45 mm de alto, así que un servidor «1U» ocupa exactamente un hueco. Los equipos se montan por delante y los cables de corriente suelen ir por la trasera, donde tienen la entrada de alimentación.

Antes de pedirlo, piensa dónde va: necesita su hueco en el suelo y medio metro libre delante y detrás. Lo ideal es dejar el frente hacia la habitación y la trasera cerca de la regleta."
reviews = Array[Dictionary]([{
"author": "Marta G.",
"date": "hace 2 semanas",
"stars": 5,
"text": "Monté el switch arriba y el servidor debajo en una tarde. Que sea abierto ayuda mucho a la hora de cablear por detrás.",
"title": "Justo lo que necesitaba para empezar",
"verified": true
}, {
"author": "Iván R.",
"date": "hace 1 mes",
"stars": 4,
"text": "Ojo con el sitio: pide medio metro libre delante y detrás. En mi cuarto tuve que girarlo para que el frente mirara a la habitación.",
"title": "Bien, pero mide lo suyo",
"verified": true
}, {
"author": "Lucía P.",
"date": "hace 3 semanas",
"stars": 5,
"text": "Los postes vienen numerados por unidades y así no montas nada a media altura.",
"title": "Sólido y bien numerado",
"verified": true
}, {
"author": "Jorge M.",
"date": "hace 2 meses",
"stars": 3,
"text": "Es abierto, así que no tiene puertas ni laterales. Para casa me vale; para una oficina buscaría uno cerrado.",
"title": "Le faltan puertas",
"verified": true
}, {
"author": "Nerea S.",
"date": "hace 5 días",
"stars": 4,
"text": "Lo compré pensando en crecer. De momento tengo dos unidades ocupadas y sobra espacio.",
"title": "Con 12U vas sobrado al principio",
"verified": false
}])
